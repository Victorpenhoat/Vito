NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=__from_supabase_start__
SUPABASE_SERVICE_ROLE_KEY=__from_supabase_start__
# Optionnels — en leur absence, adapters mock/fallback utilisés
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
MERCHANT_PARTNER_URL=
# Stripe (optionnel — absent = paiement mock). Si STRIPE_SECRET_KEY est défini,
# les 4 lignes suivantes + SUPABASE_SERVICE_ROLE_KEY deviennent obligatoires.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Clé de chiffrement des documents voyages (AES-256-GCM) — 64 caractères hex (32 octets). NE PAS commiter de vraie clé.
DOCUMENTS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Sentry (optionnel — absent = observabilité désactivée, no-op). DSN d'un projet Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Taux de change des dépenses de voyage (optionnel — absent = aucun taux proposé,
# il se saisit à la main). Frankfurter : taux de référence BCE, gratuit, sans clé.
TAUX_CHANGE_URL=https://api.frankfurter.dev/v1
# E-mails sortants (lot 1). Sans ces trois-là, rien ne part et le journal le dit.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_EXPEDITEUR=contact@vito.app
# Transport local (dev) : dépose dans Mailpit plutôt que d'envoyer pour de vrai.
# Ignorée dès que RESEND_API_KEY est renseignée ; sans objet en production.
MAIL_MAILPIT_URL=http://127.0.0.1:54324

# --- Coque iOS (Capacitor) -------------------------------------------------
# Lues par capacitor.config.ts au moment de `cap add` / `cap sync`, PAS par
# l'app web. Ce sont des variables de shell : `CAP_APP_ID=... npm run ios:regen`.
# Identifiant du bundle iOS — PROVISOIRE tant que le nom n'est pas arrêté, et
# DÉFINITIF une fois l'app créée dans App Store Connect.
CAP_APP_ID=com.exemple.vito
# Nom sous l'icône (18 caractères maximum avant d'être tronqué par iOS).
CAP_APP_NAME=Vito
# Origine chargée par la WebView. HTTPS obligatoire : le mode voyage hors ligne
# repose sur un service worker, qui exige une origine sûre.
CAP_SERVER_URL=https://vito-theta.vercel.app
# Universal Links iOS : « <TeamID>.<bundleId> », p. ex. ABCDE12345.com.exemple.vito.
# Sert le fichier /.well-known/apple-app-site-association. Absent : la route
# répond 404 — mieux qu'un fichier à moitié juste, qu'iOS mettrait en cache.
APPLE_APP_ID=
# Adresse de contact affichée sur la page publique /confidentialite (Apple exige
# une URL de politique de confidentialité joignable). Absente : un placeholder.
# Pas de préfixe public : la page est rendue par le serveur, la valeur n'a rien
# à faire dans le bundle du navigateur.
CONTACT_EMAIL=
