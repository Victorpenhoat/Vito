<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links : les domaines dont iOS confie les liens à Vito.
	     Le domaine doit servir /.well-known/apple-app-site-association (route
	     Next), et l'app doit être signée par l'équipe qui y est déclarée.
	     Généré par scripts/ios-personnaliser.mjs — ne pas éditer à la main. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:vito-theta.vercel.app</string>
	</array>
</dict>
</plist>
